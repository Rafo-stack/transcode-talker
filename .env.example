# reencoder-v3 — environment template
# Copy to .env and adapt before `docker compose up -d`. Never commit .env.
#
# v3.4: Postgres is the production default. A plain `docker compose up -d`
# without any .env works — the compose file ships sane defaults for
# everything. This file exists so you can override individual values.

# Timezone (IANA name). Empty/unset falls back to America/New_York.
TZ=America/New_York

# Basic HTTP auth — set BOTH to enable. /api/health stays public.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Database backend. v3.4 default is 'postgres'. Set to 'sqlite' to use the
# legacy single-file backend at /data/reencoder.db (the postgres service will
# still start in the compose but the app won't touch it).
DB_BACKEND=postgres

# Postgres credentials. The compose defaults to user/pass/db all = 'reencoder'
# (insecure but functional) so the stack boots with zero config. CHANGE THE
# PASSWORD before exposing the app to anyone — and remember the gotcha:
# Postgres only writes the password on FIRST boot of a fresh volume. To rotate
# later, either wipe ./data/postgres or use ALTER USER inside psql.
POSTGRES_USER=reencoder
POSTGRES_PASSWORD=reencoder
POSTGRES_DB=reencoder
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
